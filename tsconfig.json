{
  "extends": "@voxpelli/tsconfig/node20.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "**/*.js",
    "node_modules",
    "dist",
    "coverage",
    ".github"
  ]
}
