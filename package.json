{
  "name": "@domstack/create-app",
  "description": "Create a new DOMStack app",
  "version": "0.0.2",
  "author": "Bret Comnes <bcomnes@gmail.com> (https://bret.io)",
  "bugs": {
    "url": "https://github.com/bcomnes/create-domstack-app/issues"
  },
  "dependencies": {
    "@domstack/static": "^12.1.0"
  },
  "devDependencies": {
    "@voxpelli/tsconfig": "^17.0.0",
    "@types/node": "^26.0.1",
    "eslint": "^9.39.5",
    "neostandard": "^0.14.1",
    "npm-run-all2": "^9.0.0",
    "releasearoni": "^0.2.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@wix/cli": "^1.2.14",
    "wrangler": "^4.157.0",
    "vercel": "^65.17.0",
    "netlify-cli": "^27.20.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0",
    "npm": ">=10"
  },
  "homepage": "https://github.com/bcomnes/create-domstack-app",
  "keywords": [
    "domstack",
    "scaffold",
    "static-site-generator"
  ],
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "create-domstack-app": "./dist/bin.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bcomnes/create-domstack-app.git"
  },
  "scripts": {
    "prepublishOnly": "releasearoni",
    "postpublish": "npm run clean",
    "prepack": "npm run build",
    "test": "run-s test:*",
    "test:lint": "eslint .",
    "test:tsc": "tsc",
    "test:node-test": "node --experimental-test-coverage --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=lcov.info --test",
    "version": "releasearoni version",
    "smoke:local": "node scripts/smoke.ts",
    "smoke:registry": "node scripts/smoke.ts --registry",
    "build": "npm run clean && npm run build:declaration",
    "build:declaration": "tsc -p declaration.tsconfig.json",
    "clean": "rm -rf dist"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/bcomnes"
  }
}
